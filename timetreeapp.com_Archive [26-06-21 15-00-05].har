            "text": "{\"noticePosts\":[{\"id\":\"cJgMUrLpXhApVLshCSWMH\",\"title\":\"Updates to Our Privacy Policy\",\"content\":\"Revisions Effective April 15, 2026 \",\"tags\":[{\"name\":\"Android\"},{\"name\":\"iOS\"},{\"name\":\"Web\"}],\"publishDate\":\"2026-06-15T11:00:00.000+09:00\",\"url\":\"https://timetreeapp.com/intl/en/web/notice/2026-06-15/change-privacy-policy-202606-2\",\"apps\":[\"Newsroom\",\"Android\",\"iOS\",\"Web\"]},{\"id\":\"6SrsC16RodNBxAYoiu83BD\",\"title\":\"Updates to Our Privacy Policy\",\"content\":\"Revisions Effective April 15, 2026 \",\"tags\":[{\"name\":\"Android\"},{\"name\":\"iOS\"},{\"name\":\"Web\"}],\"publishDate\":\"2026-06-08T11:00:00.000+09:00\",\"url\":\"https://timetreeapp.com/intl/en/web/notice/2026-06-08/change-privacy-policy-202606-01\",\"apps\":[\"Newsroom\",\"Android\",\"iOS\",\"Web\"]},{\"id\":\"7M7YbF0xMqJJpHDJeLqkvo\",\"title\":\"Shared Calendar Guidelines Published\",\"content\":\"---\",\"tags\":[{\"name\":\"Android\"},{\"name\":\"iOS\"},{\"name\":\"Web\"}],\"publishDate\":\"2026-04-23T15:00:00.000+09:00\",\"url\":\"https://timetreeapp.com/intl/en/web/notice/2026-04-23/202604023-shared-calendar-guidelines\",\"apps\":[\"Newsroom\",\"Android\",\"iOS\",\"Web\"]},{\"id\":\"3XvWgJpBgBnoG4Ytu08Hij\",\"title\":\"Updates to Our Privacy Policy\",\"content\":\"Thank you for using TimeTree.\\nWe have updated TimeTree's Privacy Policy to make our service more convenient and secure for you.\",\"tags\":[{\"name\":\"Android\"},{\"name\":\"iOS\"},{\"name\":\"Web\"}],\"publishDate\":\"2026-04-16T15:00:00.000+09:00\",\"url\":\"https://timetreeapp.com/intl/en/web/notice/2026-04-16/change-privacy-policy-202604-02\",\"apps\":[\"Newsroom\",\"Android\",\"iOS\",\"Web\"]},{\"id\":\"4a1gmUdIMTN05QuFM2Egz8\",\"title\":\"Privacy Policy Revision Planned\",\"content\":\"Thank you for using TimeTree.\",\"tags\":[{\"name\":\"Android\"},{\"name\":\"iOS\"},{\"name\":\"Web\"}],\"publishDate\":\"2026-04-09T15:00:00.000+09:00\",\"url\":\"https://timetreeapp.com/intl/en/web/notice/2026-04-09/change-privacy-policy-202604\",\"apps\":[\"Newsroom\",\"Android\",\"iOS\",\"Web\"]},{\"id\":\"1OQVbhbt4SESApg1vn76ic\",\"title\":\"TimeTree’s 11th Anniversary & Meet Our New Friends\",\"content\":\"Thank you for always using TimeTree. Today marks TimeTree’s 11th anniversary. We are truly grateful to everyone who uses TimeTree every day.\",\"tags\":[],\"publishDate\":\"2026-03-24T11:00:00.000+09:00\",\"url\":\"https://timetreeapp.com/intl/en/web/notice/2026-03-24/11th-anniversary-new-character\",\"apps\":[\"iOS\",\"Android\",\"Web\",\"Newsroom\"]},{\"id\":\"N6qsMLBllslCosapyvEbv\",\"title\":\"Have you registered your account? Please check again.\",\"content\":\"Before switching to a new device or encountering unexpected issues, make sure your TimeTree account is set up and up to date. And don’t forget to check in with those you share your calendars with, too! \",\"tags\":[{\"name\":\"Android\"},{\"name\":\"iOS\"},{\"name\":\"Web\"}],\"publishDate\":\"2026-03-03T15:00:00.000+09:00\",\"url\":\"https://timetreeapp.com/intl/en/web/notice/2026-03-03/check-your-account-202603\",\"apps\":[\"iOS\",\"Android\",\"Newsroom\",\"Web\"]},{\"id\":\"5ZPgbOhMFIT6gzCLv8Gz1T\",\"title\":\"Updates to Our Privacy Policy\",\"content\":\"Thank you for using TimeTree. We have updated TimeTree’s Privacy Policy.\",\"tags\":[{\"name\":\"Android\"},{\"name\":\"iOS\"},{\"name\":\"Web\"}],\"publishDate\":\"2026-01-15T13:00:00.000+09:00\",\"url\":\"https://timetreeapp.com/intl/en/web/notice/2026-01-15/change-privacy-policy-202601\",\"apps\":[\"Newsroom\",\"Android\",\"iOS\",\"Web\"]},{\"id\":\"6uzau1IpCJ24ghid82CXaY\",\"title\":\"TimeTree is getting a refresh: Shape your time, your way\",\"content\":\"Thank you for always using TimeTree. We have an important announcement to share. \",\"tags\":[{\"name\":\"Android\"},{\"name\":\"iOS\"},{\"name\":\"News\"}],\"publishDate\":\"2026-01-13T11:00:00.000+09:00\",\"url\":\"https://timetreeapp.com/intl/en/web/notice/2026-01-13/renewal-timetree-newsroom\",\"apps\":[\"Newsroom\",\"Web\"]},{\"id\":\"35CZpE2HPDey51OG559H4f\",\"title\":\"Recent Updates to the Web Version!\",\"content\":\"Thank you for always using the TimeTree Web version! We’re making regular updates to improve usability on the Web version as well.\",\"tags\":[],\"publishDate\":\"2026-01-09T14:00:00.000+09:00\",\"url\":\"https://timetreeapp.com/intl/en/web/notice/2026-01-09/web-renewal-2025\",\"apps\":[\"Web\",\"Newsroom\"]}]}"
